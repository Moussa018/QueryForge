# Copier en backend/.env et completer.

# Cle du fournisseur LLM (Groq). Obligatoire pour lancer une enquete.
OPENAI_API_KEY=

# Connexion a la base. IMPORTANT : utiliser un role en LECTURE SEULE.
# Voir db/03_readonly_role.sql pour creer ce role sur votre propre base.
DATABASE_URL=postgresql+psycopg://queryforge_ro:readonly@localhost:5432/queryforge

# --- Optionnel : garde-fous ---
# STATEMENT_TIMEOUT_MS=10000
# DEFAULT_ROW_LIMIT=500
# MAX_ROW_LIMIT=5000

# --- Optionnel : introspection ---
# SCHEMA_CACHE_TTL_SECONDS=300
# INCLUDED_SCHEMAS=["public"]

# LLM_MODEL=llama-3.1-8b-instant
